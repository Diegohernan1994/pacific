---
// ServicesGrid.astro - 100% Arvune Dimensions & Animations
const serviceCategories = [
  {
    id: "interior",
    name: "Interior Remodeling",
    headline: "Thoughtful interiors designed around everyday luxury.",
    description: "Full-scale interior transformations including chef-grade Kitchen Remodeling, spa-like Bathroom Remodeling, and acoustically refined Master Suites.",
    image: "/assets/images/Kitchen.jpg",
    services: [
      { title: "Kitchen Remodeling", desc: "Custom cabinetry, bookmatched quartz islands, and high-efficiency appliances." },
      { title: "Bathroom Remodeling", desc: "Walk-in double showers, freestanding soaking tubs, and floating vanities." },
      { title: "Bedroom Remodeling", desc: "Architectural lighting, acoustic treatments, and refined custom millwork." }
    ]
  },
  {
    id: "additions",
    name: "Room Additions",
    headline: "Seamless footprint expansions engineered with structural precision.",
    description: "Expand living capacity with architecturally cohesive second-story additions, expanded master suites, modern home offices, and dedicated laundry facilities.",
    image: "/assets/images/BD28_1-scaled.jpg",
    services: [
      { title: "New Room Additions", desc: "Seamless additions expanding family living, offices, and entertainment zones." },
      { title: "Kitchen Additions", desc: "Expanding existing home footprint to create an open-concept entertaining kitchen." },
      { title: "Bathroom & Bedroom Additions", desc: "Adding luxury guest suites and full ensuite bathrooms." },
      { title: "Laundry Room Additions", desc: "Dedicated high-efficiency utility spaces with optimal plumbing connections." }
    ]
  },
  {
    id: "adu",
    name: "ADUs & New Builds",
    headline: "Turnkey secondary homes and ground-up luxury estates.",
    description: "Maximize lot value with fully permitted detached ADUs, garage conversions, and custom ground-up homes built from soil excavation to architectural handover.",
    image: "/assets/images/charming-yellow-house-with-wooden-windows-green-grassy-garden-1.webp",
    services: [
      { title: "Guest Houses & Detached ADUs", desc: "High-yielding secondary residences with independent utilities and full kitchens." },
      { title: "Garage Remodeling & Conversion", desc: "Transforming underutilized garages into luxury rental units or design studios." },
      { title: "New Structure Construction", desc: "Ground-up residential builds from foundation to custom architectural finish." }
    ]
  },
  {
    id: "structural",
    name: "Structural & Exterior",
    headline: "Engineered resilience, cool roofing, and outdoor luxury living.",
    description: "Protecting and upgrading your estate with seismic retrofit foundations, premium tile and cool roof systems, drought-tolerant hardscaping, and Title 24 energy solutions.",
    image: "/assets/images/BD22_1-1-scaled.jpg",
    services: [
      { title: "Foundation & Seismic Retrofit", desc: "Reinforced concrete footings, seismic bolting, and precision leveling." },
      { title: "Roofing Services", desc: "Spanish tile, slate, shingle, and cool-roof systems with lifetime durability." },
      { title: "Landscaping & Hardscape", desc: "Custom outdoor living spaces, pool decks, pergolas, and outdoor kitchens." },
      { title: "Energy-Efficient Upgrades", desc: "California Title 24 compliance, solar integrations, and smart automation." }
    ]
  }
];
---

<section id="services" class="py-28 lg:py-36 bg-white border-b border-brand-border">
  <div class="arvune-container space-y-16">
    
    <!-- Section Header (Arvune Grid) -->
    <div class="reveal grid grid-cols-1 lg:grid-cols-12 gap-8 items-end border-b border-brand-border pb-10">
      <div class="lg:col-span-8 space-y-3">
        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-zinc-400">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-red"></span>
          <span>Services</span>
        </div>
        <h2 class="text-3xl sm:text-5xl lg:text-[56px] font-semibold uppercase tracking-[-0.05em] text-[#0D0F0F] leading-tight">
          Refined Construction Built Around Your Vision
        </h2>
      </div>
      <div class="lg:col-span-4 lg:text-right space-y-4">
        <p class="text-sm text-zinc-500 leading-relaxed font-normal text-left lg:text-right">
          From private residential remodels to custom ADUs and complete ground-up estates, we execute with architectural purpose.
        </p>
        <div>
          <a 
            href="#contact" 
            class="arvune-btn-dark group"
          >
            <span>All Services</span>
            <span class="arvune-arrow-box-white">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </div>

    <!-- Arvune Category Selector Bar (Height: 120px) -->
    <div class="reveal delay-1 grid grid-cols-2 md:grid-cols-4 gap-3 border-b border-brand-border pb-8">
      {serviceCategories.map((cat, idx) => (
        <button 
          type="button"
          class={`service-category-btn text-left p-5 border transition-all duration-300 group flex flex-col justify-between h-[110px] sm:h-[130px] ${idx === 0 ? 'bg-[#0D0F0F] text-white border-[#0D0F0F]' : 'bg-[#F5F4F7] text-[#0D0F0F] border-transparent hover:border-zinc-300'}`}
          data-category={cat.id}
        >
          <div class="flex items-center justify-between w-full">
            <span class="text-[11px] font-bold uppercase tracking-widest text-zinc-400 group-hover:text-zinc-300">
              0{idx + 1}
            </span>
            <span class="w-7 h-7 rounded-full flex items-center justify-center border border-current text-xs group-hover:translate-x-1 transition-transform">
              →
            </span>
          </div>
          <span class="text-xs sm:text-sm font-bold uppercase tracking-tight">
            {cat.name}
          </span>
        </button>
      ))}
    </div>

    <!-- Arvune Featured Showcase Immersive Card (Min-Height: 560px) -->
    <div class="reveal delay-2 relative min-h-[500px] sm:min-h-[580px] overflow-hidden bg-zinc-100 border border-brand-border flex flex-col justify-end p-6 sm:p-12">
      <!-- Background Image (100% opacity, no dark filters) -->
      <img 
        id="service-showcase-bg"
        src={serviceCategories[0].image} 
        alt={serviceCategories[0].name}
        class="absolute inset-0 w-full h-full object-cover transition-opacity duration-500 arvune-img-zoom"
        loading="eager"
        decoding="async"
      />

      <!-- Floating Showcase Card (Width: 480px, solid background for perfect legibility) -->
      <div class="relative z-10 bg-[#0D0F0F] border border-white/10 p-6 sm:p-8 max-w-[480px] space-y-4 text-white shadow-2xl">
        <!-- Architectural Icon & Category Title -->
        <div class="space-y-1">
          <div class="inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-brand-red">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-red"></span>
            <span id="service-showcase-label">{serviceCategories[0].name}</span>
          </div>
          <h3 id="service-showcase-title" class="text-xl sm:text-2xl font-semibold uppercase tracking-[-0.03em] text-white leading-snug">
            {serviceCategories[0].headline}
          </h3>
        </div>

        <p id="service-showcase-desc" class="text-xs sm:text-sm text-zinc-400 leading-relaxed font-normal">
          {serviceCategories[0].description}
        </p>

        <!-- Services Sublist Included -->
        <div id="service-sublist" class="grid grid-cols-1 gap-2 pt-2 border-t border-white/10 text-xs text-zinc-300">
          {serviceCategories[0].services.map(s => (
            <div class="flex items-start gap-2">
              <span class="text-brand-red font-bold">✓</span>
              <span><strong>{s.title}:</strong> {s.desc}</span>
            </div>
          ))}
        </div>

        <div class="pt-2">
          <a 
            href="#contact" 
            class="arvune-btn-white group"
          >
            <span>Consult Service</span>
            <span class="arvune-arrow-box-dark">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<script define:vars={{ serviceCategories }}>
  const buttons = document.querySelectorAll('.service-category-btn');
  const bgImg = document.getElementById('service-showcase-bg');
  const label = document.getElementById('service-showcase-label');
  const title = document.getElementById('service-showcase-title');
  const desc = document.getElementById('service-showcase-desc');
  const sublist = document.getElementById('service-sublist');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const catId = btn.getAttribute('data-category');
      const catData = serviceCategories.find(c => c.id === catId);
      if (!catData) return;

      // Update button active states
      buttons.forEach(b => {
        b.classList.remove('bg-[#0D0F0F]', 'text-white', 'border-[#0D0F0F]');
        b.classList.add('bg-[#F5F4F7]', 'text-[#0D0F0F]', 'border-transparent');
      });
      btn.classList.add('bg-[#0D0F0F]', 'text-white', 'border-[#0D0F0F]');
      btn.classList.remove('bg-[#F5F4F7]', 'text-[#0D0F0F]', 'border-transparent');

      // Update showcase content
      if (bgImg) {
        bgImg.style.opacity = '0';
        setTimeout(() => {
          bgImg.src = catData.image;
          bgImg.alt = catData.name;
          bgImg.style.opacity = '1';
        }, 200);
      }
      if (label) label.textContent = catData.name;
      if (title) title.textContent = catData.headline;
      if (desc) desc.textContent = catData.description;

      if (sublist) {
        sublist.innerHTML = catData.services.map(s => `
          <div class="flex items-start gap-2">
            <span class="text-brand-red font-bold">✓</span>
            <span><strong>${s.title}:</strong> ${s.desc}</span>
          </div>
        `).join('');
      }
    });
  });
</script>
