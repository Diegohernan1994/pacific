---
---

<section id="process" class="py-24 bg-white border-b border-brand-border architectural-grid">
  <div class="max-w-7xl mx-auto px-6 space-y-16">
    <div class="max-w-2xl space-y-3">
      <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-zinc-500">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-red"></span>
        <span>The Pacific West Difference</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold uppercase tracking-[-0.05em] text-brand-dark">
        A Seamless Process from Concept to Key Handover
      </h2>
      <p class="text-brand-body text-sm sm:text-base leading-relaxed">
        We eliminate construction stress through meticulous planning, transparent fixed-bid proposals, and dedicated on-site superintendents.
      </p>
    </div>

    <!-- 3 Steps Grid (Arvune style) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Step 1 -->
      <div class="border border-brand-border p-8 bg-brand-surface space-y-6 relative group hover:border-brand-dark transition-colors">
        <span class="text-xs font-black tracking-widest text-zinc-400 block uppercase">PHASE 01</span>
        <div class="aspect-[16/10] overflow-hidden bg-zinc-900 border border-brand-border">
          <img src="/assets/images/lets-talk-1.webp" alt="Consultation and Vision Alignment" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        </div>
        <div class="space-y-2">
          <h3 class="text-xl font-bold uppercase tracking-tight text-brand-dark">Let's Talk & Align</h3>
          <p class="text-xs text-brand-body leading-relaxed">
            Schedule a detailed on-site consultation. We listen to your lifestyle goals, evaluate property constraints, and establish clear budgetary parameters.
          </p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="border border-brand-border p-8 bg-brand-surface space-y-6 relative group hover:border-brand-dark transition-colors">
        <span class="text-xs font-black tracking-widest text-zinc-400 block uppercase">PHASE 02</span>
        <div class="aspect-[16/10] overflow-hidden bg-zinc-900 border border-brand-border">
          <img src="/assets/images/addition.webp" alt="Custom Architectural Plans and Permits" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        </div>
        <div class="space-y-2">
          <h3 class="text-xl font-bold uppercase tracking-tight text-brand-dark">Tailored Plans & Permits</h3>
          <p class="text-xs text-brand-body leading-relaxed">
            Our engineers and designers prepare comprehensive architectural drawings, handle complete City of Los Angeles building permitting, and finalize material selections.
          </p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="border border-brand-border p-8 bg-brand-surface space-y-6 relative group hover:border-brand-dark transition-colors">
        <span class="text-xs font-black tracking-widest text-zinc-400 block uppercase">PHASE 03</span>
        <div class="aspect-[16/10] overflow-hidden bg-zinc-900 border border-brand-border">
          <img src="/assets/images/excellent.webp" alt="Flawless Construction and Handover" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        </div>
        <div class="space-y-2">
          <h3 class="text-xl font-bold uppercase tracking-tight text-brand-dark">Flawless Execution</h3>
          <p class="text-xs text-brand-body leading-relaxed">
            Construction is executed with precision craftsmanship and daily superintendent oversight. You receive regular progress reports up until walkthrough and turnkey delivery.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
