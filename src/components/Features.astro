<section class="py-24 bg-brand-dark text-white border-b border-white/10 architectural-grid-dark">
  <div class="max-w-7xl mx-auto px-6 space-y-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
      <div class="lg:col-span-8 space-y-3">
        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-zinc-400">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-red"></span>
          <span>Why Discerning Homeowners Choose Us</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold uppercase tracking-[-0.05em] text-white">
          What Sets Pacific West Apart
        </h2>
      </div>
      <div class="lg:col-span-4 lg:text-right">
        <p class="text-xs text-zinc-400 leading-relaxed uppercase tracking-wider">
          Excellence beyond expectations on every square foot.
        </p>
      </div>
    </div>

    <!-- 5 Pillars Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
      <div class="border border-white/10 p-6 bg-white/5 space-y-3">
        <span class="text-xs font-mono font-bold text-brand-red block">01</span>
        <h3 class="text-base font-bold uppercase tracking-tight text-white">Luxury-Centric Designs</h3>
        <p class="text-xs text-zinc-400 leading-relaxed">
          We blend timeless aesthetics with modern California functionality to craft spaces that elevate daily life.
        </p>
      </div>

      <div class="border border-white/10 p-6 bg-white/5 space-y-3">
        <span class="text-xs font-mono font-bold text-brand-red block">02</span>
        <h3 class="text-base font-bold uppercase tracking-tight text-white">Title 24 Sustainability</h3>
        <p class="text-xs text-zinc-400 leading-relaxed">
          High-efficiency insulation, solar readiness, and sustainable materials to reduce carbon footprints.
        </p>
      </div>

      <div class="border border-white/10 p-6 bg-white/5 space-y-3">
        <span class="text-xs font-mono font-bold text-brand-red block">03</span>
        <h3 class="text-base font-bold uppercase tracking-tight text-white">Clear Communication</h3>
        <p class="text-xs text-zinc-400 leading-relaxed">
          Fixed-price contract transparency and real-time project updates with zero surprise invoices.
        </p>
      </div>

      <div class="border border-white/10 p-6 bg-white/5 space-y-3">
        <span class="text-xs font-mono font-bold text-brand-red block">04</span>
        <h3 class="text-base font-bold uppercase tracking-tight text-white">Master Craftsmanship</h3>
        <p class="text-xs text-zinc-400 leading-relaxed">
          Every trim, tile seam, and structural beam is handled by licensed, certified trade specialists.
        </p>
      </div>

      <div class="border border-white/10 p-6 bg-white/5 space-y-3">
        <span class="text-xs font-mono font-bold text-brand-red block">05</span>
        <h3 class="text-base font-bold uppercase tracking-tight text-white">Turnkey Management</h3>
        <p class="text-xs text-zinc-400 leading-relaxed">
          From soil tests to final city inspection, our team manages every bureaucratic and technical detail.
        </p>
      </div>
    </div>
  </div>
</section>
